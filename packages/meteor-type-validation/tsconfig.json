{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "rootDir": "./",
    "moduleResolution": "bundler",
    "baseUrl": "./",
    "paths": {
      "@meteor-type-validation/server": [
        "./src/server/index.ts"
      ],
      "@meteor-type-validation/client": [
        "./src/client/index.ts"
      ],
      "@meteor-type-validation/utils": [
        "./src/utils/index.ts"
      ],
      "@meteor-type-validation/types": [
        "./src/types/index.ts"
      ]
    },
    "types": [],
    "declaration": true,
    "outDir": "./dist",
    "stripInternal": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "tsup.config.ts",
    "env.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./tests/build-output"
  ]
}
